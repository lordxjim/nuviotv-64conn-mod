+ * Ledger tests for the native-tier chunk budget, pinned to the REAL device RAM
+ * tiers of NuvioExoPlayerPerformanceHelper.getSafeNativeMemoryLimitMb()
+ * (100 / 200 / 200 / 500 / 1000 / 1600 / 2000 MB) and to the reserve semantics
+ * of MemoryBudget.nativeChunkBudgetMb (streaming floor MIN_BUFFER_MB, not the
+ * managed target itself).
+ *
+ * Regression background: the previous wiring charged the whole allocator target
+ * as the reserve (safeNative - targetBufferSizeMb). In managed performance mode
+ * the target EQUALS the safe native limit, so the chunk budget collapsed to
+ * zero, the guard pinned every connection count to its 1 MB floor (settings UI
+ * offered only 256 KB / 512 KB / 1 MB) and the prefetch depth check went inert
+ * at its c+1 floor.
+ */
+@OptIn(UnstableApi::class)
+class MemoryBudgetNativeChunkBudgetTest {
+
+    // Real safe-native tiers by RAM band: <=1.15GB→100, <1.45GB→200, <2.3GB→200,
+    // <3.2GB→500, <4.8GB→1000, <6.8GB→1600, else→2000.
+    private val realTiers = intArrayOf(100, 200, 500, 1000, 1600, 2000)
+
+    @Test
+    fun testNativeChunkBudgetManagedModeIsNeverZero() {
+        // Managed mode: target == safe limit. The old wiring (safeNative - target)
+        // returned 0 here for EVERY tier; the budget is now the total minus the
+        // streaming floor (MIN_BUFFER_MB = 25).
+        realTiers.forEach { tier ->
+            assertEquals(tier - 25, MemoryBudget.nativeChunkBudgetMb(tier, tier))
+        }
+    }
+
+    @Test
+    fun testNativeChunkBudgetCustomTargetBelowLimit() {
+        // Custom (non-managed) target: the window must fit inside what the user
+        // actually granted, not the device ceiling.
+        assertEquals(75, MemoryBudget.nativeChunkBudgetMb(100, 1000))
+        assertEquals(25, MemoryBudget.nativeChunkBudgetMb(50, 200))
+    }
+
+    @Test
+    fun testNativeChunkBudgetOverrideCappedBySafeLimit() {
+        // Large-target-buffer override may raise the target above the safe limit;
+        // the extra buys streaming headroom only, never window headroom.
+        assertEquals(175, MemoryBudget.nativeChunkBudgetMb(2048, 200))
+        assertEquals(975, MemoryBudget.nativeChunkBudgetMb(2048, 1000))
+    }
+
+    @Test
+    fun testNativeChunkBudgetFloorZero() {
+        assertEquals(0, MemoryBudget.nativeChunkBudgetMb(10, 200))
+        assertEquals(0, MemoryBudget.nativeChunkBudgetMb(25, 2000))
+    }
+
+    @Test
+    fun testSafeChunkScalingOnTwoGbTier() {
+        // 2 GB-class TV (RAM < 2.3 GB -> safeNative 200), managed mode.
+        val budget = MemoryBudget.nativeChunkBudgetMb(200, 200) // 175
+        assertEquals(25, MemoryBudget.safeChunkMbForConnections(2, budget))
+        assertEquals(13, MemoryBudget.safeChunkMbForConnections(8, budget))
+        assertEquals(8, MemoryBudget.safeChunkMbForConnections(16, budget))
+        assertEquals(4, MemoryBudget.safeChunkMbForConnections(32, budget))
+        assertEquals(2, MemoryBudget.safeChunkMbForConnections(64, budget))
+    }
+
+    @Test
+    fun testUiFilterCapOnTwoGbTier() {
+        // The exact user-reported scenario: 2 GB-class TV, performance mode,
+        // 64 connections. Old wiring: budget 0 -> cap 1 MB -> only 256 KB /
+        // 512 KB / 1 MB offered. Fixed wiring: cap 2 MB (256 KB ... 2 MB).
+        val uiCap64 = minOf(
+            16, // MemoryBudget.tierMaxChunkMb on the low-RAM tier
+            MemoryBudget.safeChunkMbForConnections(
+                64,
+                MemoryBudget.nativeChunkBudgetMb(200, 200)
+            )
+        )
+        assertEquals(2, uiCap64)
+        // And at 16 connections the slider reaches 8 MB again.
+        val uiCap16 = minOf(
+            16,
