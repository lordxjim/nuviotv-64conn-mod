+     * the native window budget — the primary engine-side guard at high connection
+     * counts. Lowering the connection count is the right lever when the pair does not
+     * fit: clamping the chunk instead (the old [safeChunkMbForConnections] behaviour)
+     * pins the chunk to its 1 MB floor while the window still overcommits. Callers
+     * combine this with the configured hard cap (e.g. 256 on the native tier).
+     */
+    fun maxConnectionsForWindowBytes(windowBudgetBytes: Long, chunkBytes: Long): Int =
+        ((windowBudgetBytes / chunkBytes.coerceAtLeast(1L)) - 1L)
+            .toInt()
+            .coerceAtLeast(MIN_CONNECTIONS)
+
+    /**
