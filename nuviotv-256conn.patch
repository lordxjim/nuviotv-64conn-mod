+     * (= 2 Mbps) stall threshold kills perfectly healthy connections whenever the
+     * carrier throttles per-connection throughput below that mark, and each kill costs
+     * a fresh TCP slow start plus a TIME_WAIT socket. The threshold instead tracks the
+     * session's own median chunk rate at a quarter, floored at 16 KB/s: only genuinely
+     * stalled transfers (no progress at all, or four times slower than the session
+     * median) are restarted. Empty samples fall back to the legacy CDN constant so the
+     * first chunks of a session behave exactly as before.
+     */
+    fun hedgeStallThresholdBps(sampleRatesBps: List<Long>, legacyDefaultBps: Long): Long {
+        if (sampleRatesBps.isEmpty()) return legacyDefaultBps
+        val sorted = sampleRatesBps.sorted()
+        val median = sorted[sorted.size / 2]
+        return maxOf(HEDGE_STALL_FLOOR_BPS, median / 4L)
+    }
