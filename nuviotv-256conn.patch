+        // P1/P2: hard concurrency gate with a dynamic AIMD ceiling. Every window chunk
+        // download acquires a permit; the ceiling starts at the configured connection
+        // count, is halved (floored at MemoryBudget.aimdGateFloor) on 429 episodes and
+        // recovered additively while quiet — replacing the depth-halving collapse that
+        // pinned throughput to 1-2 connections for minutes. Waiters recheck the ceiling
+        // on every release, so a seek's fresh chunks are not starved behind the backlog.
+        private class ConnectionGate(initialConnections: Int) {
+            private val lock = Object()
+            private var maxPermits = initialConnections.coerceAtLeast(1)
+            private var ceiling = maxPermits
+            private var inUse = 0
+
+            fun acquire() {
+                synchronized(lock) {
+                    while (inUse >= ceiling) lock.wait()
+                    inUse++
+                }
+            }
+
+            fun release() {
+                synchronized(lock) {
+                    if (inUse > 0) inUse--
+                    lock.notifyAll()
+                }
+            }
+
+            /** Multiplicative decrease on a 429 episode; returns the new ceiling. */
+            fun onRateLimited(): Int {
+                synchronized(lock) {
+                    val target = com.nuvio.tv.ui.screens.settings.MemoryBudget.aimdDecreaseGate(ceiling, maxPermits)
+                    if (target < ceiling) {
+                        ceiling = target
+                        lock.notifyAll()
+                    }
+                    return ceiling
+                }
+            }
+
+            /** Additive increase while rate-limit quiet; returns the new ceiling. */
+            fun recover(): Int {
+                synchronized(lock) {
+                    ceiling = com.nuvio.tv.ui.screens.settings.MemoryBudget.aimdIncreaseGate(ceiling, maxPermits)
+                    lock.notifyAll()
+                    return ceiling
+                }
+            }
+
+            fun isThrottled(): Boolean {
+                synchronized(lock) { return ceiling < maxPermits }
+            }
+
+            fun maxPermits(): Int {
+                synchronized(lock) { return maxPermits }
+            }
+
+            /** Config raised between plays: grow the budget, keep an active clamp intact. */
+            fun expandMax(connections: Int) {
+                synchronized(lock) {
+                    if (connections <= maxPermits) return
+                    val wasAtMax = ceiling == maxPermits
+                    maxPermits = connections
+                    if (wasAtMax) ceiling = maxPermits
+                    lock.notifyAll()
+                }
+            }
+        }
