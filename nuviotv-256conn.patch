+    @Test
+    fun testSafeChunkAcrossAllRealTiers() {
+        // Integer-division ledger per tier (budget = tier - 25, divisor = c + 5).
+        val expected = mapOf(
+            100 to intArrayOf(10, 5, 3, 2, 1),    // budget 75:  75/7, /13, /21, /37, /69
+            200 to intArrayOf(25, 13, 8, 4, 2),   // budget 175
+            500 to intArrayOf(67, 36, 22, 12, 6), // budget 475
+            1000 to intArrayOf(128, 75, 46, 26, 14),  // budget 975 (975/7=139 capped at 128)
+            1600 to intArrayOf(128, 121, 75, 42, 22), // budget 1575 (1575/7=225 capped at 128)
+            2000 to intArrayOf(128, 128, 94, 53, 28), // budget 1975, capped at MAX_CHUNK_MB
+        )
+        val conns = intArrayOf(2, 8, 16, 32, 64)
+        expected.forEach { (tier, caps) ->
+            val budget = MemoryBudget.nativeChunkBudgetMb(tier, tier)
+            conns.forEachIndexed { i, c ->
+                assertEquals("tier=$tier conn=$c", caps[i].toLong(),
+                    MemoryBudget.safeChunkMbForConnections(c, budget).toLong())
+            }
+        }
+    }
+
+    @Test
+    fun testWorstCaseRetainedSetFitsBudget() {
+        // safeChunk = budget / (c + 1 + 4), so the worst-case retained set
+        // (window floor + in-flight headroom) always fits the budget exactly.
+        realTiers.forEach { tier ->
+            val budget = MemoryBudget.nativeChunkBudgetMb(tier, tier)
+            intArrayOf(2, 8, 16, 32, 64).forEach { c ->
+                val chunk = MemoryBudget.safeChunkMbForConnections(c, budget)
+                assertTrue("tier=$tier conn=$c", (c + 5) * chunk <= budget)
+            }
+        }
+    }
+
+    @Test
+    fun testPrefetchDepthBudgetActiveAfterFix() {
+        // 2 GB-class TV, managed mode (total 200, reserve 25 -> 175 MB budget):
+        // the depth check is no longer inert at the c+1 floor.
+        assertEquals(175, MemoryBudget.prefetchDepthChunks(64, 1, 200, 25)) // 175/1 = 175
+        assertEquals(87, MemoryBudget.prefetchDepthChunks(64, 2, 200, 25))  // 175/2 = 87
+        assertEquals(21, MemoryBudget.prefetchDepthChunks(16, 8, 200, 25))  // 175/8 = 21
+        // Crash safety on a starving budget: floors at c+1 instead of throwing
+        // (the old coerceIn(c*2, c*4) threw IllegalArgumentException here).
+        assertEquals(65, MemoryBudget.prefetchDepthChunks(64, 1, 30, 25))   // budget 5 -> floor
+    }
+
+    @Test
+    fun testDepthTimesChunkWithinBudgetWhenFunded() {
+        // Whenever the budget funds at least the c+1 floor, depth x chunk stays
+        // within the chunk budget on every real tier.
+        realTiers.forEach { tier ->
+            val budget = MemoryBudget.nativeChunkBudgetMb(tier, tier)
+            intArrayOf(2, 8, 16, 32, 64).forEach { c ->
+                val chunk = MemoryBudget.safeChunkMbForConnections(c, budget)
+                val depth = MemoryBudget.prefetchDepthChunks(c, chunk, tier, 25)
+                val byBudget = budget / chunk.coerceAtLeast(1)
+                if (byBudget >= c + 1) {
