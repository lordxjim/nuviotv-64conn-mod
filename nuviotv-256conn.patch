new file mode 100644
index 00000000..1e3ca038
--- /dev/null
+++ b/.github/workflows/dev-256-build.yml
@@ -0,0 +1,88 @@
+name: Dev 256 Build
+
+# 256-connection parallel engine development branch.
+# Builds a signed-with-CI-keystore fullDebug APK on every push to dev-256
+# (and on demand), running the full app unit-test suite first so the
+# parallel-engine ledger tests (MemoryBudgetParallel256Test and friends) gate
+# the artifact. The release workflow (android-release.yml) stays untouched:
+# it is manually dispatched per release with the production signing secrets.
+
+on:
+  push:
+    branches: [dev-256]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: dev-256-build-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  dev-256-build:
+    name: Test + build fullDebug APK (256-tier)
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Java
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "17"
+          cache: gradle
+
+      - name: Prepare local properties
+        env:
+          LOCAL_PROPERTIES_BASE64: ${{ secrets.LOCAL_PROPERTIES_BASE64 }}
+          LOCAL_DEV_PROPERTIES_BASE64: ${{ secrets.LOCAL_DEV_PROPERTIES_BASE64 }}
+        run: |
+          if [ -n "$LOCAL_PROPERTIES_BASE64" ]; then
+            printf '%s' "$LOCAL_PROPERTIES_BASE64" | base64 --decode > local.properties
+          else
+            touch local.properties
+          fi
+
+          if [ -n "$LOCAL_DEV_PROPERTIES_BASE64" ]; then
+            printf '%s' "$LOCAL_DEV_PROPERTIES_BASE64" | base64 --decode > local.dev.properties
+          else
+            touch local.dev.properties
+          fi
+
+      - name: Prepare CI signing config
+        run: |
+          keytool -genkeypair \
+            -v \
+            -keystore "$RUNNER_TEMP/ci-debug.jks" \
+            -storepass android \
+            -alias androiddebugkey \
+            -keypass android \
+            -dname "CN=Android Debug,O=Android,C=US" \
+            -keyalg RSA \
+            -keysize 2048 \
+            -validity 10000
+
+          {
+            echo "NUVIO_RELEASE_STORE_FILE=$RUNNER_TEMP/ci-debug.jks"
+            echo "NUVIO_RELEASE_KEY_ALIAS=androiddebugkey"
+            echo "NUVIO_RELEASE_KEY_PASSWORD=android"
+            echo "NUVIO_RELEASE_STORE_PASSWORD=android"
+          } >> "$GITHUB_ENV"
+
+      - name: Run full unit test suite (incl. parallel-256 ledger tests)
+        run: ./gradlew :app:testFullDebugUnitTest --stacktrace
+
+      - name: Build fullDebug APK
+        run: ./gradlew :app:assembleFullDebug --stacktrace
+
+      - name: Upload fullDebug APK
+        uses: actions/upload-artifact@v7
+        with:
+          name: NuvioTV-dev256-fullDebug-${{ github.sha }}
+          path: app/build/outputs/apk/full/debug/app-full-universal-debug.apk
+          archive: false
+          if-no-files-found: error
+          retention-days: 14
