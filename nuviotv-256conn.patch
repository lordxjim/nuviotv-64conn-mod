+@file:OptIn(UnstableApi::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Ledger tests for the 256-connection tier: byte-accurate prefetch depth
+ * (MemoryBudget.prefetchDepthBytes), the connection-count clamp
+ * (MemoryBudget.maxConnectionsForWindowBytes) and the adaptive hedge stall
+ * threshold (MemoryBudget.hedgeStallThresholdBps).
+ *
+ * Regression background: the MB-based depth rounded sub-MB chunks up (a 512 KB
+ * chunk was charged as 1 MB) and its coerceIn(conns + 1, ...) floor silently
+ * oversold memory once conns + 1 chunks no longer fit the window budget —
+ * 256 x 1 MB needs 257 MB against the 175 MB budget of a 2 GB device
+ * (nativeChunkBudgetMb = safeNative 200 - MIN_BUFFER_MB 25). The old
+ * safeChunkMbForConnections-only guard made that WORSE at high counts: it
+ * clamped the chunk to its 1 MB floor while the window still overcommitted.
+ *
+ * The fixed 256 KB/s (2 Mbps) hedge stall threshold killed healthy connections
+ * under carrier evening throttling (0.5-2 Mbps per connection); the adaptive
+ * threshold tracks a quarter of the session's median chunk rate, floored at
+ * 16 KB/s, so only genuine stalls are restarted.
+ */
+@OptIn(UnstableApi::class)
+class MemoryBudgetParallel256Test {
+
+    private val mb = 1024L * 1024L
+    private val kb = 1024L
+
+    // Real native window budgets by RAM band: safe limit - MIN_BUFFER_MB (25).
+    private val tier2GbBudgetBytes = 175L * mb   // 1.15-2.3 GB band (safe 200)
+    private val tier3GbBudgetBytes = 475L * mb   // 2.3-3.2 GB band (safe 500)
+    private val tier4GbBudgetBytes = 975L * mb   // 3.2-4.8 GB band (safe 1000)
+
+    // ── prefetchDepthBytes ────────────────────────────────────────────────────
+
+    @Test
+    fun testDepthNeverExceedsByteBudget() {
+        // The old MB formula returned 257 chunks for 256 x 1 MB on every tier
+        // (coerceIn floor), overselling 82 MB on the 2 GB budget.
+        val depth = MemoryBudget.prefetchDepthBytes(256, mb, tier2GbBudgetBytes)
+        assertEquals(175, depth)
+        assertTrue(depth * mb <= tier2GbBudgetBytes)
+    }
+
+    @Test
+    fun testDepthByteAccurateForSubMbChunks() {
+        // 256 x 512 KB on the 2 GB tier: the MB formula charged each 512 KB chunk
+        // as 1 MB (byBudget = 175); the byte-accurate form funds 350 real chunks.
+        val depth = MemoryBudget.prefetchDepthBytes(256, 512L * kb, tier2GbBudgetBytes)
+        assertEquals(350, depth)
+        assertEquals(tier2GbBudgetBytes, depth * 512L * kb)
+    }
+
+    @Test
+    fun testDepthUpperMultipleCapPreserved() {
+        // Upper bound stays 4x the window floor: 2 connections -> at most 12 chunks.
+        assertEquals(12, MemoryBudget.prefetchDepthBytes(2, mb, tier4GbBudgetBytes))
+        assertEquals(24, MemoryBudget.prefetchDepthBytes(5, mb, tier4GbBudgetBytes))
+    }
+
+    @Test
+    fun testDepthMemoryBoundedWhenFloorCannotBeFunded() {
+        // Budget cannot fund conns + 1 chunks: the window is memory-bounded and
+        // never throws (the MB variant's coerceIn would have raised the depth to
+        // the floor and oversold). Callers clamp the connection count instead.
+        assertEquals(10, MemoryBudget.prefetchDepthBytes(256, 16L * mb, tier2GbBudgetBytes))
+        assertEquals(1, MemoryBudget.prefetchDepthBytes(256, 256L * mb, tier2GbBudgetBytes))
+    }
+
+    @Test
+    fun testDepthOn3GbTierFundsFullWindow() {
+        // 256 x 1 MB on the 3 GB tier: budget 475 MB, floor 257 -> byBudget 475.
+        assertEquals(475, MemoryBudget.prefetchDepthBytes(256, mb, tier3GbBudgetBytes))
+    }
+
+    @Test
+    fun testDepthMatchesLegacyBehaviourWhenBudgetIsNotBinding() {
+        // 64 x 1 MB on every tier must keep the 64-era values (budget >= 65 chunks
+        // funds the same window the MB formula produced).
+        assertEquals(175, MemoryBudget.prefetchDepthBytes(64, mb, tier2GbBudgetBytes))
+        assertEquals(260, MemoryBudget.prefetchDepthBytes(64, mb, tier3GbBudgetBytes))
+    }
+
+    // ── maxConnectionsForWindowBytes ──────────────────────────────────────────
+
+    @Test
+    fun testMaxConnectionsByTier() {
+        assertEquals(174, MemoryBudget.maxConnectionsForWindowBytes(tier2GbBudgetBytes, mb))
+        assertEquals(349, MemoryBudget.maxConnectionsForWindowBytes(tier2GbBudgetBytes, 512L * kb))
+        assertEquals(474, MemoryBudget.maxConnectionsForWindowBytes(tier3GbBudgetBytes, mb))
+    }
+
+    @Test
+    fun testMaxConnectionsFloorsAtMinimum() {
+        // Budget smaller than a single chunk: degenerate config, floor at
+        // MIN_CONNECTIONS instead of zero/negative.
+        assertEquals(2, MemoryBudget.maxConnectionsForWindowBytes(mb, 2L * mb))
+        assertEquals(2, MemoryBudget.maxConnectionsForWindowBytes(0, mb))
+    }
+
+    @Test
+    fun testComposedGuardMatchesShippedPresets() {
+        // The engine-side guard composes the funded count with the configured hard
+        // cap (PlayerSettings.MAX_PARALLEL_CONNECTION_COUNT_NATIVE_MEMORY = 256).
+        // 2 GB @ 1 MB -> 174; 2 GB @ 512 KB -> 256 (capped, 349 funded); 3 GB+ -> 256.
+        val cap = 256
+        assertEquals(174, minOf(cap, MemoryBudget.maxConnectionsForWindowBytes(tier2GbBudgetBytes, mb)))
+        assertEquals(256, minOf(cap, MemoryBudget.maxConnectionsForWindowBytes(tier2GbBudgetBytes, 512L * kb)))
+        assertEquals(256, minOf(cap, MemoryBudget.maxConnectionsForWindowBytes(tier3GbBudgetBytes, mb)))
+    }
+
+    // ── hedgeStallThresholdBps ────────────────────────────────────────────────
+
+    @Test
+    fun testHedgeThresholdFallsBackToLegacyWithoutSamples() {
+        // First chunks of a session (no completed-chunk samples yet) behave
+        // exactly as before: CDN 256 KB/s, usenet 128 KB/s.
+        assertEquals(256L * kb, MemoryBudget.hedgeStallThresholdBps(emptyList(), 256L * kb))
+        assertEquals(128L * kb, MemoryBudget.hedgeStallThresholdBps(emptyList(), 128L * kb))
+    }
+
+    @Test
+    fun testHedgeThresholdProtectsThrottledHealthyConnections() {
+        // Session median ~128 KB/s (1 Mbps carrier throttle): threshold drops to
+        // 32 KB/s, so a steady 128 KB/s connection is no longer restarted. The
+        // fixed 256 KB/s constant killed exactly this connection.
+        val samples = List(16) { 128L * kb + (it - 8) * 512L }
+        assertEquals(32L * kb, MemoryBudget.hedgeStallThresholdBps(samples, 256L * kb))
+        assertTrue(128L * kb >= MemoryBudget.hedgeStallThresholdBps(samples, 256L * kb))
+    }
+
+    @Test
+    fun testHedgeThresholdFlooredAtAbsoluteMinimum() {
+        // Even a crawling session (median 8 KB/s) never lets the threshold below
+        // 16 KB/s: zero-progress windows must always trip the stall detector.
+        val samples = List(8) { 8L * kb }
+        assertEquals(16L * kb, MemoryBudget.hedgeStallThresholdBps(samples, 256L * kb))
+    }
+
+    @Test
+    fun testHedgeThresholdKeepsLegacyValueOnFastLines() {
+        // Fast session (median 1 MB/s): quarter = 256 KB/s — identical to the old
+        // constant, so unthrottled behaviour does not regress.
+        val samples = List(8) { mb }
+        assertEquals(256L * kb, MemoryBudget.hedgeStallThresholdBps(samples, 256L * kb))
+    }
+
+    @Test
+    fun testHedgeFloorConstant() {
+        assertEquals(16L * kb, MemoryBudget.HEDGE_STALL_FLOOR_BPS)
+    }
+}
