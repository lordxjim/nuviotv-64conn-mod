+    // ─── P2: gate-based AIMD (connection-count control during 429 episodes) ────
+    //
+    // The 64-era depth clamp halved the prefetch window toward 1 chunk and recovered
+    // +1 per 10-60 s: at high connection counts that collapsed throughput to 1-2
+    // connections for minutes. With the hard connection gate in place the depth cap
+    // only limits queued work, so 429 backoff now acts on the GATE ceiling — the
+    // actual number of concurrent connections — with multiplicative decrease and
+    // additive increase, both floored/capped so parallelism never dies completely.
+    // Full recovery takes <= 16 steps at the base step interval.
+
+    /** AIMD decrease floor: 1/16 of the configured count, at least 8, never above it. */
+    fun aimdGateFloor(connections: Int): Int =
+        (connections / 16).coerceAtLeast(8).coerceAtMost(connections.coerceAtLeast(1))
+
+    /** Multiplicative decrease: halve the ceiling, floored at [aimdGateFloor]. */
+    fun aimdDecreaseGate(ceiling: Int, connections: Int): Int =
+        (ceiling / 2).coerceAtLeast(aimdGateFloor(connections))
+
+    /** Additive increase: +1/16 of the configured count per quiet step, capped at it. */
+    fun aimdIncreaseGate(ceiling: Int, connections: Int): Int =
+        (ceiling + (connections / 16).coerceAtLeast(1)).coerceAtMost(connections)
+
+    /**
+     * Depth-cap floor during 429 episodes. The window may shrink under load but never
+     * below 1/8 of its configured size (min 16 chunks): with the gate limiting real
+     * connections, a near-empty window only starves scheduling without reducing
+     * server-facing load any further.
+     */
+    fun rateLimitDepthFloor(configuredDepth: Int): Int =
+        (configuredDepth / 8).coerceAtLeast(16).coerceAtMost(configuredDepth)
+
+    /** Depth-cap recovery step: proportional (+1/8) instead of the old +1 per interval. */
+    fun rateLimitDepthStep(configuredDepth: Int): Int =
+        (configuredDepth / 8).coerceAtLeast(1)
+
+    // ─── P4: bounded cancel drain ──────────────────────────────────────────────
+    //
+    // okhttp only returns a connection to the pool when the response body has been
+    // read to the end. Cancelling a chunk download mid-body therefore kills the
+    // socket — and after a seek, ALL in-flight chunks cancel at once, forcing the
+    // refill through cold re-handshakes. Draining a NEARLY-complete body (<= 64 KB)
+    // is cheap (about a second even at 0.5 Mbps) and keeps the socket warm; larger
+    // remainders are closed instead, since draining them would waste exactly the
+    // per-connection bandwidth the throttle allots.
+    const val CANCEL_DRAIN_MAX_BYTES = 64L * 1024L
+
+    fun shouldDrainForReuse(remainingBytes: Long): Boolean =
+        remainingBytes in 1..CANCEL_DRAIN_MAX_BYTES
+
