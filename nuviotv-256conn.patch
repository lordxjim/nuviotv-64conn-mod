+        // floor holds — the 64-era depth clamp instead walked to 1 and pinned
+        // throughput there for minutes.
+        var ceiling = 256
+        ceiling = MemoryBudget.aimdDecreaseGate(ceiling, 256)
+        assertEquals(128, ceiling)
+        ceiling = MemoryBudget.aimdDecreaseGate(ceiling, 256)
+        assertEquals(64, ceiling)
+        ceiling = MemoryBudget.aimdDecreaseGate(ceiling, 256)
+        assertEquals(32, ceiling)
+        ceiling = MemoryBudget.aimdDecreaseGate(ceiling, 256)
+        assertEquals(16, ceiling)
+        ceiling = MemoryBudget.aimdDecreaseGate(ceiling, 256)
+        assertEquals(16, ceiling)
+        assertEquals(16, MemoryBudget.aimdDecreaseGate(16, 256))
+    }
+
+    @Test
+    fun testAimdIncreaseRecoversProportionally() {
+        // +1/16 of the configured count per quiet step, capped at it: full recovery
+        // from the 256-tier floor takes 15 steps, not the 240 single steps (+1 each,
+        // 10-60 s apart) the 64-era depth stepper needed.
+        assertEquals(32, MemoryBudget.aimdIncreaseGate(16, 256))
+        assertEquals(256, MemoryBudget.aimdIncreaseGate(240, 256))
+        assertEquals(256, MemoryBudget.aimdIncreaseGate(256, 256))
+        assertEquals(12, MemoryBudget.aimdIncreaseGate(8, 64))
+        var ceiling = 16
+        var steps = 0
+        while (ceiling < 256 && steps < 32) {
+            ceiling = MemoryBudget.aimdIncreaseGate(ceiling, 256)
+            steps++
+        }
+        assertEquals(256, ceiling)
+        assertTrue(steps in 1..16)
+    }
+
+    @Test
+    fun testRateLimitDepthFloorAndStep() {
+        // Depth cap floors at 1/8 of the window (min 16): the window may shrink under
+        // a 429 storm but never starves scheduling outright; recovery is +1/8 per step.
+        assertEquals(21, MemoryBudget.rateLimitDepthFloor(175))
+        assertEquals(16, MemoryBudget.rateLimitDepthFloor(100))
+        assertEquals(12, MemoryBudget.rateLimitDepthFloor(12))
+        assertEquals(59, MemoryBudget.rateLimitDepthFloor(475))
+        assertEquals(21, MemoryBudget.rateLimitDepthStep(175))
+        assertEquals(59, MemoryBudget.rateLimitDepthStep(475))
+        assertEquals(1, MemoryBudget.rateLimitDepthStep(12))
+    }
+
+    // ── P4: bounded cancel drain ──────────────────────────────────────────────
+
+    @Test
+    fun testCancelDrainBudget() {
+        // Nearly-complete bodies (<= 64 KB remaining) are drained so the socket returns
+        // to the pool; anything larger is closed instead of wasting throttled
+        // per-connection bandwidth on discarded bytes.
+        assertTrue(MemoryBudget.shouldDrainForReuse(1L))
+        assertTrue(MemoryBudget.shouldDrainForReuse(64L * kb))
+        assertFalse(MemoryBudget.shouldDrainForReuse(0L))
+        assertFalse(MemoryBudget.shouldDrainForReuse(-1L))
+        assertFalse(MemoryBudget.shouldDrainForReuse(64L * kb + 1L))
+        assertFalse(MemoryBudget.shouldDrainForReuse(mb))
+        assertEquals(64L * kb, MemoryBudget.CANCEL_DRAIN_MAX_BYTES)
+    }
