+    /**
+     * Byte-accurate window depth for the native tier. The MB-based [prefetchDepthChunks]
+     * rounds sub-MB chunks up (a 512 KB chunk is charged as 1 MB) and its
+     * coerceIn(connections + 1, ...) floor silently oversells memory once conns + 1
+     * chunks no longer fit the budget — e.g. 256 x 1 MB needs 257 MB against a 175 MB
+     * budget on a 2 GB device. This variant never exceeds the budget and never throws:
+     * when the budget cannot fund connections + 1 chunks the window is simply
+     * memory-bounded, and the connection count itself is clamped upstream via
+     * [maxConnectionsForWindowBytes] so the conns + 1 floor stays meaningful.
+     */
+    fun prefetchDepthBytes(connections: Int, chunkBytes: Long, windowBudgetBytes: Long): Int {
+        val chunk = chunkBytes.coerceAtLeast(1L)
+        val byBudget = (windowBudgetBytes / chunk).toInt()
+        val floor = connections + 1
+        if (byBudget >= floor) {
+            return byBudget.coerceAtMost(floor * PREFETCH_DEPTH_UPPER_MULTIPLE)
+        }
+        return byBudget.coerceAtLeast(1)
+    }
