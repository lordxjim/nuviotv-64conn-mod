@@ -34,6 +34,10 @@ object MemoryBudget {
     private const val PREFETCH_DEPTH_LOWER_MULTIPLE = 2
     private const val PREFETCH_DEPTH_UPPER_MULTIPLE = 4
 
+    // In-flight chunk headroom above the window depth, mirroring the session chunk cap
+    // (depth + 2 low-RAM / + 4 otherwise); used by the engine-side chunk guard.
+    private const val IN_FLIGHT_CHUNK_HEADROOM = 4
+
     const val MIN_CONNECTIONS = 2
     const val MAX_CONNECTIONS = 4
     const val MIN_CHUNK_MB = 8
@@ -169,12 +173,27 @@ object MemoryBudget {
         val chunkBudgetMb = (safeNativeLimitMb - reserveBufferMb.coerceAtLeast(0))
             .coerceAtLeast(chunkMb * PREFETCH_DEPTH_LOWER_MULTIPLE)
         val byBudget = chunkBudgetMb / chunkMb
-        return byBudget.coerceIn(
-            connections * PREFETCH_DEPTH_LOWER_MULTIPLE,
-            connections * PREFETCH_DEPTH_UPPER_MULTIPLE
-        )
+        // The window never drops below connections + 1 (the reader's own chunk must always be
+        // schedulable), and it only exceeds the budget's own chunk count when the connection
+        // count itself demands it. The old coerceIn(connections * 2, connections * 4) threw
+        // IllegalArgumentException whenever the budget could not fund 2 chunks per connection,
+        // which 64 connections reaches on every tier.
+        val byConnections = connections + 1
+        return byBudget.coerceIn(byConnections, byConnections * PREFETCH_DEPTH_UPPER_MULTIPLE)
     }
 
+    /**
+     * Largest chunk size whose worst-case retained set still fits the buffer budget:
+     * (connections + 1 + in-flight headroom) buffers, mirroring the session chunk cap
+     * (depth + 2 low-RAM / + 4 otherwise) plus the reader's own chunk. Keeps the engine
+     * memory-bounded when the configured chunk would overcommit, e.g. 64 connections
+     * with 8-16 MB chunks on a 2 GB device. Floor is 1 MB: below that, lowering the
+     * connection count is the right lever, not smaller chunks.
+     */
+    fun safeChunkMbForConnections(connections: Int, bufferBudgetMb: Int): Int =
+        (bufferBudgetMb / (connections + IN_FLIGHT_CHUNK_HEADROOM + 1))
+            .coerceIn(1, MAX_CHUNK_MB)
+
     /** Max chunk size that fits budget given current buffer size */
     fun maxChunkMb(bufferMb: Int, connectionCount: Int): Int =
         ((budgetMb - bufferMb) / bufferCount(connectionCount)).coerceIn(MIN_CHUNK_MB, tierMaxChunkMb)
