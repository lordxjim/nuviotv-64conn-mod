+                        Log.w(TAG, "Chunk $chunkIndex download failed (attempt ${attempt + 1}/$CHUNK_RETRY_BUDGET), retrying: ${e.message}")
+                    }
+                    // Jittered pause: a fixed interval re-syncs workers that failed together
+                    // into a retry herd against the same host.
+                    try {
+                        Thread.sleep(CHUNK_RETRY_BASE_DELAY_MS + (Math.random() * CHUNK_RETRY_JITTER_MS).toLong())
