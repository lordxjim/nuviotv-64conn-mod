         var lastException: Exception? = null
-        for (attempt in 0..1) {
+        for (attempt in 0 until CHUNK_RETRY_BUDGET) {
 
             if (future.isDone || future.isCancelled || activeSession.abandoned.get()) throw IOException("Cancelled")
             try {
@@ -1189,20 +1200,22 @@ internal class ParallelRangeDataSource(
                 if (rlError != null) {
                     return downloadChunkWithRateLimitBackoff(activeSession, chunkIndex, future, rlError)
                 }
-                if (attempt == 0) {
+                if (attempt < CHUNK_RETRY_BUDGET - 1) {
                     if (e.isTransientInterruption()) {
-                        Log.d(TAG, "Chunk $chunkIndex interrupted during prefetch (attempt 1), retrying")
-                        try {
-                            Thread.sleep(50)
-                        } catch (_: InterruptedException) {
-                        }
+                        Log.d(TAG, "Chunk $chunkIndex interrupted during prefetch (attempt ${attempt + 1}), retrying")
