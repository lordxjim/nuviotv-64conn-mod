+     * override target above the safe limit buys streaming headroom only, never window
+     * headroom, hence the min().
+     */
+    fun nativeChunkBudgetMb(targetBufferMb: Int, safeNativeLimitMb: Int): Int =
+        (minOf(targetBufferMb, safeNativeLimitMb) - MIN_BUFFER_MB).coerceAtLeast(0)
+
